{% extends 'base.html.twig' %}

{% block title %}{{ event.name|default('Event Details') }} - JoindIn{% endblock %}

{% block body %}
<div class="container py-4">
    {% if event %}
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('joindin_events') }}">JoindIn Events</a></li>
                <li class="breadcrumb-item active" aria-current="page">{{ event.name }}</li>
            </ol>
        </nav>

        <div class="card">
            <div class="card-header bg-primary text-white">
                <h2 class="mb-0">
                    <i class="bi bi-calendar-event"></i> {{ event.name }}
                </h2>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-8">
                        <h4 class="mb-3">Event Description</h4>
                        <div class="event-description mb-4">
                            {% if event.description is defined and event.description %}
                                {{ event.description|nl2br }}
                            {% else %}
                                <p class="text-muted">No description available for this event.</p>
                            {% endif %}
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card bg-light">
                            <div class="card-body">
                                <h5 class="card-title mb-3">
                                    <i class="bi bi-info-circle"></i> Event Details
                                </h5>
                                <ul class="list-unstyled mb-0">
                                    <li class="mb-2">
                                        <strong><i class="bi bi-calendar"></i> Start Date:</strong><br>
                                        {% if event.start_date is defined and event.start_date %}
                                            {{ event.start_date|date('l, F d, Y') }}
                                        {% else %}
                                            <span class="text-muted">Not specified</span>
                                        {% endif %}
                                    </li>
                                    <li class="mb-2">
                                        <strong><i class="bi bi-calendar-check"></i> End Date:</strong><br>
                                        {% if event.end_date is defined and event.end_date %}
                                            {{ event.end_date|date('l, F d, Y') }}
                                        {% else %}
                                            <span class="text-muted">Not specified</span>
                                        {% endif %}
                                    </li>
                                    <li class="mb-2">
                                        <strong><i class="bi bi-geo-alt"></i> Location:</strong><br>
                                        {% if event.tz_place is defined and event.tz_place %}
                                            {{ event.tz_place }}
                                        {% else %}
                                            <span class="text-muted">Not specified</span>
                                        {% endif %}
                                    </li>
                                    {% if event.attendee_count is defined %}
                                    <li class="mb-2">
                                        <strong><i class="bi bi-people"></i> Attendees:</strong><br>
                                        {{ event.attendee_count }}
                                    </li>
                                    {% endif %}
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <div class="d-flex justify-content-between align-items-center">
                    <a href="{{ path('joindin_events') }}" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Back to Events
                    </a>
                    {% set eventId = event.uri|split('/')|last %}
                    <a href="{{ path('joindin_talks', {'eventId': eventId}) }}" class="btn btn-success">
                        <i class="bi bi-mic"></i> View Talks
                    </a>
                </div>
            </div>
        </div>
    {% else %}
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle"></i> Event not found or unable to load event details.
        </div>
        <a href="{{ path('joindin_events') }}" class="btn btn-primary">
            <i class="bi bi-arrow-left"></i> Back to Events
        </a>
    {% endif %}
</div>
{% endblock %}
