{% extends 'base.html.twig' %}

{% block title %}Talks - {{ event.name|default('Event') }} - JoindIn{% endblock %}

{% block body %}
<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('joindin_events') }}">JoindIn Events</a></li>
            {% if event %}
                {% set eventId = event.uri|split('/')|last %}
                <li class="breadcrumb-item"><a href="{{ path('joindin_event', {'eventId': eventId}) }}">{{ event.name }}</a></li>
            {% endif %}
            <li class="breadcrumb-item active" aria-current="page">Talks</li>
        </ol>
    </nav>

    <div class="hero-section mb-4">
        <h1><i class="bi bi-mic"></i> Talks</h1>
        {% if event %}
            <p class="lead mb-0">Sessions from {{ event.name }}</p>
        {% endif %}
    </div>

    {% if talks is empty %}
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No talks found for this event.
        </div>
    {% else %}
        <div class="row">
            {% for talk in talks %}
                <div class="col-12 mb-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <h4 class="card-title mb-0">
                                    <i class="bi bi-chat-square-text text-primary"></i>
                                    {{ talk.talk_title|default('Untitled Talk') }}
                                </h4>
                                <div class="rating-badge">
                                    {% if talk.average_rating is defined and talk.average_rating %}
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-star-fill"></i> 
                                            {{ talk.average_rating|number_format(1) }} / 5
                                        </span>
                                    {% else %}
                                        <span class="badge bg-secondary">
                                            <i class="bi bi-star"></i> No ratings
                                        </span>
                                    {% endif %}
                                </div>
                            </div>

                            {% if talk.speakers is defined and talk.speakers %}
                                <p class="text-muted mb-2">
                                    <i class="bi bi-person"></i>
                                    <strong>Speaker(s):</strong>
                                    {% for speaker in talk.speakers %}
                                        {{ speaker.speaker_name }}{% if not loop.last %}, {% endif %}
                                    {% endfor %}
                                </p>
                            {% endif %}

                            {% if talk.type is defined and talk.type %}
                                <p class="mb-2">
                                    <span class="badge bg-info">{{ talk.type }}</span>
                                </p>
                            {% endif %}

                            <h5 class="mt-3 mb-2">Abstract</h5>
                            <div class="talk-abstract">
                                {% if talk.talk_description is defined and talk.talk_description %}
                                    <p class="card-text">{{ talk.talk_description|nl2br }}</p>
                                {% else %}
                                    <p class="text-muted">No abstract available for this talk.</p>
                                {% endif %}
                            </div>

                            {% if talk.slides_link is defined and talk.slides_link %}
                                <div class="mt-3">
                                    <a href="{{ talk.slides_link }}" target="_blank" class="btn btn-outline-primary btn-sm">
                                        <i class="bi bi-file-earmark-slides"></i> View Slides
                                    </a>
                                </div>
                            {% endif %}
                        </div>
                        <div class="card-footer bg-light">
                            <div class="row text-muted small">
                                {% if talk.start_date is defined and talk.start_date %}
                                    <div class="col-auto">
                                        <i class="bi bi-clock"></i> {{ talk.start_date|date('M d, Y H:i') }}
                                    </div>
                                {% endif %}
                                {% if talk.duration is defined and talk.duration %}
                                    <div class="col-auto">
                                        <i class="bi bi-hourglass"></i> {{ talk.duration }} mins
                                    </div>
                                {% endif %}
                                {% if talk.comment_count is defined %}
                                    <div class="col-auto">
                                        <i class="bi bi-chat"></i> {{ talk.comment_count }} comments
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    <div class="mt-4 d-flex gap-2">
        <a href="{{ path('joindin_events') }}" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Events
        </a>
        {% if event %}
            {% set eventId = event.uri|split('/')|last %}
            <a href="{{ path('joindin_event', {'eventId': eventId}) }}" class="btn btn-primary">
                <i class="bi bi-file-text"></i> Event Details
            </a>
        {% endif %}
    </div>
</div>
{% endblock %}
