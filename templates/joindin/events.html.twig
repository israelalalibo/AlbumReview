{% extends 'base.html.twig' %}

{% block title %}JoindIn Past Events{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="hero-section mb-4">
        <h1><i class="bi bi-calendar-event"></i> JoindIn Past Events</h1>
        <p class="lead mb-0">Browse past tech events from the JoindIn community</p>
    </div>

    {% if events is empty %}
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No events found or unable to connect to JoindIn API.
        </div>
    {% else %}
        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Event Name</th>
                                <th scope="col">Date</th>
                                <th scope="col">Location</th>
                                <th scope="col" class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for event in events %}
                                <tr>
                                    <td>
                                        <strong>{{ event.name }}</strong>
                                    </td>
                                    <td>
                                        {% if event.start_date is defined and event.start_date %}
                                            {{ event.start_date|date('M d, Y') }}
                                        {% else %}
                                            <span class="text-muted">N/A</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if event.tz_place is defined and event.tz_place %}
                                            <i class="bi bi-geo-alt"></i> {{ event.tz_place }}
                                        {% else %}
                                            <span class="text-muted">N/A</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-center">
                                        {% set eventId = event.uri|split('/')|last %}
                                        <a href="{{ path('joindin_event', {'eventId': eventId}) }}" class="btn btn-sm btn-primary me-1">
                                            <i class="bi bi-file-text"></i> Description
                                        </a>
                                        <a href="{{ path('joindin_talks', {'eventId': eventId}) }}" class="btn btn-sm btn-success">
                                            <i class="bi bi-mic"></i> Talks
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    {% endif %}

    <div class="mt-4">
        <a href="{{ path('home') }}" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Home
        </a>
    </div>
</div>
{% endblock %}
