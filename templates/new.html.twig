{% extends 'base.html.twig' %}

{% block title %}New Announcement{% endblock %}

{% block body %}
    <h1>Create a New Announcement</h1>

    {# Show flash messages (confirmation/errors) #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div style="padding:10px; margin-bottom:10px; background-color: {% if label == 'success' %}#d4edda{% else %}#f8d7da{% endif %};">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <form method="post" action="{{ path('new_announcement') }}">
        <label for="message">Message:</label><br>
        <input type="text" id="message" name="message" required style="width: 300px;"><br><br>

        <button type="submit">Save Announcement</button>
    </form>
{% endblock %}
