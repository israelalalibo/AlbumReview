{% extends 'base.html.twig' %}

{% block body %}
    <h1>Add a New Announcement</h1>

    {% for message in app.flashes('success') %}
        <div style="background: #d4edda; padding: 10px; margin-bottom: 10px;">
            {{ message }}
        </div>
    {% endfor %}

    {{ form_start(form) }}
    {{ form_row(form.message) }}
    <button type="submit">Save</button>
    {{ form_end(form) }}
{% endblock %}
