{% extends 'base.html.twig' %}

{% block title %}Buy {{ album.title }} by {{ album.artist }}{% endblock %}

{% block body %}
<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('album_index') }}">Albums</a></li>
            <li class="breadcrumb-item"><a href="{{ path('album_show', {'slug': album.slug}) }}">{{ album.title }}</a></li>
            <li class="breadcrumb-item active">Buy</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-md-4">
            <div class="card mb-4">
                {% if album.coverImage %}
                    <img src="{{ asset('uploads/albums/' ~ album.coverImage) }}" class="card-img-top" alt="{{ album.title }}">
                {% else %}
                    <div class="card-img-top bg-secondary text-white d-flex align-items-center justify-content-center" style="height: 300px;">
                        <i class="bi bi-disc" style="font-size: 5rem;"></i>
                    </div>
                {% endif %}
                <div class="card-body">
                    <h4 class="card-title">{{ album.title }}</h4>
                    <p class="card-text text-muted">{{ album.artist }}</p>
                    <p class="card-text">
                        <span class="badge bg-primary">{{ album.genre }}</span>
                        {% if album.releaseYear %}
                            <span class="badge bg-secondary">{{ album.releaseYear }}</span>
                        {% endif %}
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <h2><i class="bi bi-cart"></i> Where to Buy</h2>

            {% if purchaseInfo %}
                {% if purchaseInfo.lowestPrice is defined and purchaseInfo.lowestPrice %}
                    <div class="alert-success">
                        <h5><i class="bi bi-tag"></i> Lowest Price Found</h5>
                        <p class="display-6 mb-0">${{ purchaseInfo.lowestPrice|number_format(2) }}</p>
                        <small class="text-muted">{{ purchaseInfo.numForSale|default(0) }} copies available on Discogs</small>
                    </div>
                {% endif %}

                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-vinyl"></i> Discogs Marketplace</h5>
                    </div>
                    <div class="card-body">
                        {% if purchaseInfo.community is defined %} {#display the community statistics#}
                            <div class="row mb-3">
                                <div class="col-4 text-center">
                                    <div class="h4">{{ purchaseInfo.community.have|default(0) }}</div>
                                    <small class="text-muted">Collectors Have</small>
                                </div>
                                <div class="col-4 text-center">
                                    <div class="h4">{{ purchaseInfo.community.want|default(0) }}</div>
                                    <small class="text-muted">Collectors Want</small>
                                </div>
                                <div class="col-4 text-center">
                                    <div class="h4">
                                        {% if purchaseInfo.community.rating is defined and purchaseInfo.community.rating > 0 %}
                                            {{ purchaseInfo.community.rating|number_format(1) }}/5
                                        {% else %}
                                            N/A
                                        {% endif %}
                                    </div>
                                    <small class="text-muted">Rating</small>
                                </div>
                            </div>
                        {% endif %}

                        {% if purchaseInfo.formats is defined and purchaseInfo.formats %}
                            <p>
                                <strong>Available Formats:</strong>
                                {% for format in purchaseInfo.formats %}
                                    <span class="badge bg-info">{{ format.name }}</span>
                                {% endfor %}
                            </p>
                        {% endif %}

                        <a href="{{ purchaseInfo.marketplaceUrl|default('#') }}" target="_blank" class="btn btn-primary btn-lg">
                            <i class="bi bi-cart-plus"></i> View on Discogs Marketplace
                        </a>
                    </div>
                </div>
            {% else %}
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle"></i> No marketplace information found for this album.
                </div>
            {% endif %}

            {# eBay Listings Section #}
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-shop-window"></i> eBay Listings
                        {% if ebayResults.source is defined and ebayResults.source == 'demo' %}
                            <span class="badge bg-warning text-dark ms-2">Demo Data</span>
                        {% endif %}
                    </h5>
                </div>
                <div class="card-body">
                    {% if ebayResults.notice is defined %}
                        <div class="alert-info small mb-3">
                            <i class="bi bi-info-circle"></i> {{ ebayResults.notice }} {#display the notice to let users know that this is demo data#}
                        </div>
                    {% endif %}
                    
                    {% if ebayResults.items|default([])|length > 0 %}
                        <div class="row row-cols-1 row-cols-md-2 g-3 mb-3">
                            {% for item in ebayResults.items|slice(0, 4) %}
                                <div class="col">
                                    <div class="card h-100 border-0 shadow-sm">
                                        <div class="card-body p-3">
                                            <h6 class="card-title small text-truncate" title="{{ item.title }}">
                                                {{ item.title|length > 50 ? item.title|slice(0, 50) ~ '...' : item.title }}
                                            </h6>
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <span class="h5 text-primary mb-0">{{ item.price.formatted }}</span>
                                                <span class="badge {{ item.condition == 'New' ? 'bg-success' : 'bg-secondary' }}">
                                                    {{ item.condition }}
                                                </span>
                                            </div>
                                            <div class="small text-muted mb-2">
                                                <i class="bi bi-geo-alt"></i> {{ item.location }}
                                                {% if item.shipping == 'Free' %}
                                                    <span class="badge bg-success ms-1">Free Shipping</span>
                                                {% else %}
                                                    <span class="ms-1">+ {{ item.shipping }} shipping</span>
                                                {% endif %}
                                            </div>
                                            <div class="small text-muted mb-2">
                                                <i class="bi bi-person"></i> {{ item.seller }}
                                                <span class="text-success">({{ item.feedbackPercentage|number_format(1) }}% positive)</span>
                                            </div>
                                            {% if item.bids %}
                                                <div class="small">
                                                    <span class="badge bg-warning text-dark">
                                                        <i class="bi bi-hammer"></i> {{ item.bids }} bid{{ item.bids > 1 ? 's' : '' }}
                                                    </span>
                                                </div>
                                            {% elseif item.buyItNow %}
                                                <span class="badge bg-info">Buy It Now</span>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                        
                        {% if ebayResults.items|length > 0 %}
                            <div class="d-flex justify-content-between align-items-center">
                                <small class="text-muted">
                                    Showing {{ ebayResults.items|length }} of {{ ebayResults.total }} listings
                                </small>
                                <a href="{{ ebayResults.searchUrl }}" target="_blank" class="btn btn-primary">
                                    <i class="bi bi-box-arrow-up-right"></i> View All on eBay
                                </a>
                            </div>
                        {% endif %}
                    {% else %}
                        <p class="text-muted mb-0">No listings found on eBay.</p>
                    {% endif %}
                </div>
            </div>

            {# Amazon Listings Section #}
            <div class="card mb-4">
                <div class="card-header bg-warning">
                    <h5 class="mb-0 text-dark">
                        <i class="bi bi-box-seam"></i> Amazon Listings
                        {% if amazonResults.source is defined and amazonResults.source == 'demo' %}
                            <span class="badge bg-dark ms-2">Demo Data</span>
                        {% endif %}
                    </h5>
                </div>
                <div class="card-body">
                    {% if amazonResults.notice is defined %}
                        <div class="alert-info small mb-3">
                            <i class="bi bi-info-circle"></i> {{ amazonResults.notice }}
                        </div>
                    {% endif %}
                    
                    {% if amazonResults.items|default([])|length > 0 %}
                        <div class="row row-cols-1 row-cols-md-2 g-3 mb-3">
                            {% for item in amazonResults.items|slice(0, 4) %}
                                <div class="col">
                                    <div class="card h-100 border-0 shadow-sm">
                                        <div class="card-body p-3">
                                            <h6 class="card-title small text-truncate" title="{{ item.title }}">
                                                {{ item.title|length > 50 ? item.title|slice(0, 50) ~ '...' : item.title }}
                                            </h6>
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <span class="h5 text-warning mb-0">{{ item.price.formatted }}</span>
                                                <span class="badge {{ item.condition == 'New' ? 'bg-success' : 'bg-secondary' }}">
                                                    {{ item.condition }}
                                                </span>
                                            </div>
                                            <div class="small text-muted mb-2">
                                                <i class="bi bi-vinyl"></i> {{ item.format|default('Vinyl') }}
                                                {% if item.prime %}
                                                    <span class="badge bg-info ms-2">
                                                        <i class="bi bi-lightning-fill"></i> Prime
                                                    </span>
                                                {% endif %}
                                            </div>
                                            {% if item.artist %}
                                                <div class="small text-muted">
                                                    <i class="bi bi-person"></i> {{ item.artist }}
                                                </div>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                        
                        {% if amazonResults.items|length > 0 %}
                            <div class="d-flex justify-content-between align-items-center">
                                <small class="text-muted">
                                    Showing {{ amazonResults.items|length }} of {{ amazonResults.total }} products
                                </small>
                                <a href="{{ amazonResults.searchUrl }}" target="_blank" class="btn btn-warning text-dark">
                                    <i class="bi bi-box-arrow-up-right"></i> View All on Amazon
                                </a>
                            </div>
                        {% endif %}
                    {% else %}
                        <p class="text-muted mb-0">No products found on Amazon.</p>
                    {% endif %}
                </div>
            </div>

            <div class="mt-4">
                <a href="{{ path('record_stores') }}" class="btn btn-success">
                    <i class="bi bi-geo-alt"></i> Find Record Stores Near You
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
