{% extends 'base.html.twig' %}

{% block title %}My Profile{% endblock %}

{% block body %}
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow">
                    <div class="card-header bg-primary text-white">
                        <h4 class="mb-0">
                            <i class="bi bi-person-circle"></i> My Profile
                        </h4>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4 text-center">
                                {% if user.profileImage %}
                                    <img src="{{ asset('uploads/profiles/' ~ user.profileImage) }}"
                                         alt="{{ user.username }}"
                                         class="img-fluid rounded-circle mb-3"
                                         style="width: 150px; height: 150px; object-fit: cover; border: 3px solid #6366f1;">
                                {% else %}
                                    <div class="bg-secondary rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                                         style="width: 150px; height: 150px; border: 3px solid #6366f1;">
                                        <i class="bi bi-person-fill display-1 text-white"></i>
                                    </div>
                                {% endif %}

                                <div class="d-grid gap-2">
                                    <a href="{{ path('profile_edit') }}" class="btn btn-primary">
                                        <i class="bi bi-pencil"></i> Edit Profile
                                    </a>
                                    <a href="{{ path('profile_settings') }}" class="btn btn-outline-secondary">
                                        <i class="bi bi-gear"></i> Settings
                                    </a>
                                </div>
                            </div>

                            <div class="col-md-8">
                                <h3 class="mb-4">{{ user.username }}</h3>

                                <div class="mb-4">
                                    <h5 class="text-muted">Account Information</h5>
                                    <hr>

                                    <div class="row mb-3">
                                        <div class="col-sm-4 fw-bold">Email:</div>
                                        <div class="col-sm-8">{{ user.email }}</div>
                                    </div>

                                    <div class="row mb-3">
                                        <div class="col-sm-4 fw-bold">Username:</div>
                                        <div class="col-sm-8">{{ user.username }}</div>
                                    </div>

                                    <div class="row mb-3">
                                        <div class="col-sm-4 fw-bold">Role:</div>
                                        <div class="col-sm-8">
                                            {% if 'ROLE_ADMIN' in user.roles %}
                                                <span class="badge bg-danger">Administrator</span>
                                            {% elseif 'ROLE_MODERATOR' in user.roles %}
                                                <span class="badge bg-warning">Moderator</span>
                                            {% else %}
                                                <span class="badge bg-secondary">User</span>
                                            {% endif %}
                                        </div>
                                    </div>

                                    <div class="row mb-3">
                                        <div class="col-sm-4 fw-bold">Member Since:</div>
                                        <div class="col-sm-8">{{ user.createdAt|date('F j, Y') }}</div>
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <h5 class="text-muted">Activity Statistics</h5>
                                    <hr>

                                    <div class="row mb-3">
                                        <div class="col-sm-4 fw-bold">Albums Created:</div>
                                        <div class="col-sm-8">
                                            <span class="badge bg-primary">{{ user.albumsCreated|length }}</span>
                                        </div>
                                    </div>

                                    <div class="row mb-3">
                                        <div class="col-sm-4 fw-bold">Reviews Written:</div>
                                        <div class="col-sm-8">
                                            <span class="badge bg-success">{{ user.reviews|length }}</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                {# Recent Activity #}
                <div class="card shadow mt-4">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">
                            <i class="bi bi-clock-history"></i> Recent Reviews
                        </h5>
                    </div>
                    <div class="card-body">
                        {% if user.reviews|length > 0 %}
                            <div class="list-group">
                                {% for review in user.reviews|slice(0, 5) %}
                                    <a href="{{ path('album_show', {slug: review.album.slug}) }}"
                                       class="list-group-item list-group-item-action">
                                        <div class="d-flex w-100 justify-content-between">
                                            <h6 class="mb-1">{{ review.album.title }} - {{ review.album.artist }}</h6>
                                            <small>{{ review.createdAt|date('M d, Y') }}</small>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center">
                                            <p class="mb-1 text-muted">
                                                {{ review.content|length > 100 ? review.content|slice(0, 100) ~ '...' : review.content }}
                                            </p>
                                            <span class="badge bg-warning text-dark">
                                            <i class="bi bi-star-fill"></i> {{ review.rating }}/10
                                        </span>
                                        </div>
                                    </a>
                                {% endfor %}
                            </div>
                        {% else %}
                            <p class="text-muted">No reviews yet. Start reviewing albums!</p>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
