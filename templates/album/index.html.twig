{% extends 'base.html.twig' %}

{% block title %}Albums{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Albums</h1>
        {# Is the person trying to create the new album already a user? #}
        {% if is_granted('ROLE_USER') %}
            <a href="{{ path('album_new') }}" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Add Album
            </a>
        {% endif %}
    </div>

    {# Search and Filter Form #}
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" action="{{ path('album_index') }}">
                <div class="row g-3">
                    <div class="col-md-4">
                        <input type="text" name="q" class="form-control" placeholder="Search albums or artists..."
                               value="{{ current_query }}">
                    </div>
                    <div class="col-md-3">
                        <select name="genre" class="form-select">
                            <option value="">All Genres</option>
                            {% for genre in genres %}
                                <option value="{{ genre }}" {{ current_genre == genre ? 'selected' : '' }}>{{ genre }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-2">
                        <input type="number" name="year" class="form-control" placeholder="Year" value="{{ current_year }}" min="1900" max="{{ 'now'|date('Y') }}">
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-search"></i> Search
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    {# Albums Grid to display albums#}
    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4 mb-4">
        {% for album in albums %}
            <div class="col">
                <div class="card h-100 shadow-sm">
                    {% if album.coverImage %}
                        <img src="{{ asset('uploads/albums/' ~ album.coverImage) }}" class="card-img-top" alt="{{ album.title }}" style="height: 200px; object-fit: cover;">
                    {% else %}
                        <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                            <i class="bi bi-disc display-3 text-white"></i>
                        </div>
                    {% endif %}
                    <div class="card-body">
                        <h5 class="card-title">{{ album.title }}</h5>
                        <p class="card-text text-muted mb-2">{{ album.artist }}</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="badge bg-primary">{{ album.genre }}</span>
                            {% if album.reviews|length > 0 %}
                                <span class="text-warning">
                                <i class="bi bi-star-fill"></i> {{ album.averageRating|number_format(1) }}
                            </span>
                            {% endif %}
                        </div>
                        <small class="text-muted d-block mt-2">
                            {{ album.reviews|length }} review{{ album.reviews|length != 1 ? 's' : '' }}
                        </small>
                    </div>
                    <div class="card-footer bg-transparent">
                        <a href="{{ path('album_show', {slug: album.slug}) }}" class="btn btn-sm btn-outline-primary w-100">
                            View Details
                        </a>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <div class="alert alert-info">
                    No albums found. {% if is_granted('ROLE_USER') %}<a href="{{ path('album_new') }}">Add the first one!</a>{% endif %}
                </div>
            </div>
        {% endfor %}
    </div>

    {# Pagination #}
    <div class="d-flex justify-content-center">
        {{ knp_pagination_render(albums) }}
    </div>
{% endblock %}
