{% extends 'base.html.twig' %}

{% block title %}{{ album.title }} - {{ album.artist }}{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-md-4 mb-4">
            {% if album.coverImage %}
                <img src="{{ asset('uploads/albums/' ~ album.coverImage) }}" class="img-fluid rounded shadow" alt="{{ album.title }}">
            {% else %}
                <div class="bg-secondary rounded shadow d-flex align-items-center justify-content-center" style="height: 400px;">
                    <i class="bi bi-disc display-1 text-white"></i>
                </div>
            {% endif %}

            {% if is_granted('ROLE_USER') %}
                <div class="d-grid gap-2 mt-3">
                    {# Allow either a moderator or the person that created the album to edit the album  #}
                    {% if app.user == album.createdBy or is_granted('ROLE_MODERATOR') %}
                        <a href="{{ path('album_edit', {slug: album.slug}) }}" class="btn btn-warning">
                            <i class="bi bi-pencil"></i> Edit Album
                        </a>
                    {% endif %}
                    {# Deleting the album should only be allowed for ADMINS or the person that made the album #}
                    {% if app.user == album.createdBy or is_granted('ROLE_ADMIN') %}
                        <form method="post" action="{{ path('album_delete', {id: album.id}) }}" onsubmit="return confirm('Are you sure you want to delete this album and all its reviews?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ album.id) }}">
                            <button class="btn btn-danger w-100">
                                <i class="bi bi-trash"></i> Delete Album
                            </button>
                        </form>
                    {% endif %}
                </div>
            {% endif %}
        </div>

        <div class="col-md-8">
            <h1>{{ album.title }}</h1>
            <h3 class="text-muted">{{ album.artist }}</h3>

            <div class="mb-3">
                <span class="badge bg-primary fs-6">{{ album.genre }}</span>
                {% if album.releaseYear %}
                    <span class="badge bg-secondary fs-6">{{ album.releaseYear }}</span>
                {% endif %}
            </div>

            {% if album.reviews|length > 0 %}
                <div class="alert alert-info">
                    <h4 class="alert-heading">
                        <i class="bi bi-star-fill text-warning"></i>
                        {{ album.averageRating|number_format(1) }}/10
                    </h4>
                    <p class="mb-0">Based on {{ album.reviews|length }} review{{ album.reviews|length != 1 ? 's' : '' }}</p>
                </div>
            {% endif %}

            {% if album.trackListAsArray|length > 0 %}
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-music-note-list"></i> Track List</h5>
                    </div>
                    <ul class="list-group list-group-flush">
                        {% for track in album.trackListAsArray %}
                            <li class="list-group-item">{{ loop.index }}. {{ track }}</li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            {# MusicBrainz Information - External API Integration #}
            <div class="card mb-4 border-info">
                <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-globe"></i> MusicBrainz Database Info</h5>
                    <button type="button" id="mb-fetch-btn" class="btn btn-light btn-sm">
                        <i class="bi bi-arrow-clockwise"></i> Fetch Info
                    </button>
                </div>
                <div class="card-body">
                    <div id="mb-loading" class="text-center py-3" style="display: none;">
                        <div class="spinner-border text-info" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-2 mb-0">Fetching data from MusicBrainz...</p>
                    </div>
                    <div id="mb-content" style="display: none;">
                        <div class="row">
                            <div class="col-md-6">
                                <p><strong>Release Date:</strong> <span id="mb-release-date">-</span></p>
                                <p><strong>Country:</strong> <span id="mb-country">-</span></p>
                                <p><strong>Record Label:</strong> <span id="mb-label">-</span></p>
                            </div>
                            <div class="col-md-6">
                                <p><strong>Barcode:</strong> <span id="mb-barcode">-</span></p>
                                <p><strong>Status:</strong> <span id="mb-status">-</span></p>
                                <p><strong>Track Count:</strong> <span id="mb-track-count">-</span></p>
                            </div>
                        </div>
                        <div id="mb-tracks-section" style="display: none;">
                            <hr>
                            <h6><i class="bi bi-music-note-list"></i> Official Track Listing (from MusicBrainz)</h6>
                            <ol id="mb-tracks-list" class="mb-0"></ol>
                        </div>
                        <hr>
                        <small class="text-muted">
                            <i class="bi bi-info-circle"></i> Data provided by 
                            <a href="https://musicbrainz.org" target="_blank">MusicBrainz</a>, 
                            the open music encyclopedia.
                        </small>
                    </div>
                    <div id="mb-placeholder">
                        <p class="text-muted mb-0">
                            <i class="bi bi-info-circle"></i> 
                            Click "Fetch Info" to load additional album information from the MusicBrainz database, 
                            including official release date, record label, and track durations.
                        </p>
                    </div>
                    <div id="mb-error" class="alert alert-warning mb-0" data-persistent-alert="true" style="display: none;"></div>
                </div>
            </div>

            <div class="mb-3">
                <small class="text-muted">
                    Added by {{ album.createdBy.username }} on {{ album.createdAt|date('F j, Y') }}
                </small>
            </div>

            {# Purchase Options - Creative Feature #}
            <div class="card mb-4 border-success">
                <div class="card-body">
                    <h5 class="card-title text-success">
                        <i class="bi bi-cart-check"></i> Want to own this album?
                    </h5>
                    <p class="card-text">Find vinyl records, CDs, and local record stores.</p>
                    <div class="d-flex gap-2 flex-wrap">
                        <a href="{{ path('album_buy', {slug: album.slug}) }}" class="btn btn-success">
                            <i class="bi bi-vinyl"></i> Where to Buy
                        </a>
                        <a href="{{ path('record_stores') }}" class="btn btn-outline-success">
                            <i class="bi bi-geo-alt"></i> Find Stores Near Me
                        </a>
                    </div>
                </div>
            </div>

            <hr>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3>Reviews ({{ album.reviews|length }})</h3>
                {% if is_granted('ROLE_USER') %}
                    {% set userReview = null %}
                    {% for review in album.reviews %}
                        {%  if review.user == app.user %}
                            {% set userReview = review %}
                        {% endif %}
                    {% endfor %}

                    {% if userReview is null %}
                        {# To see if the user has written any review yet, if not allow to write review #}
                        <a href="{{ path('review_new', {slug: album.slug}) }}" class="btn btn-success">
                            <i class="bi bi-plus-circle"></i> Write Review
                        </a>
                    {% endif %}
                {% endif %}
            </div>

            {% for review in album.reviews %}
                <div class="card mb-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                {% if review.title %}
                                    <h5 class="card-title mb-1">{{ review.title }}</h5>
                                {% endif %}
                                <h6 class="text-muted">
                                    <i class="bi bi-person-circle"></i> {{ review.user.username }}
                                </h6>
                            </div>
                            <div class="text-end">
                            <span class="badge bg-warning text-dark fs-6">
                                <i class="bi bi-star-fill"></i> {{ review.rating }}/10
                            </span>
                            </div>
                        </div>
                        <p class="card-text">{{ review.content }}</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <small class="text-muted">
                                {{ review.createdAt|date('F j, Y') }}
                                {% if review.updatedAt %}
                                    (edited {{ review.updatedAt|date('F j, Y') }})
                                {% endif %}
                            </small>
                            {% if is_granted('ROLE_USER') and (app.user == review.user or is_granted('ROLE_MODERATOR')) %}
                                <div>
                                    <a href="{{ path('review_edit', {slug: album.slug, reviewId: review.id}) }}" class="btn btn-sm btn-outline-warning">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    {% if app.user == review.user or is_granted('ROLE_ADMIN') %}
                                        <form method="post" action="{{ path('review_delete', {slug: album.slug, reviewId: review.id}) }}" class="d-inline" onsubmit="return confirm('Are you sure?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ review.id) }}">
                                            <button class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i> Delete
                                            </button>
                                        </form>
                                    {% endif %}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="alert alert-secondary">
                    <p class="mb-0">No reviews yet. {% if is_granted('ROLE_USER') %}Be the first to review this album!{% endif %}</p>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const fetchBtn = document.getElementById('mb-fetch-btn');
            const loadingDiv = document.getElementById('mb-loading');
            const contentDiv = document.getElementById('mb-content');
            const placeholderDiv = document.getElementById('mb-placeholder');
            const errorDiv = document.getElementById('mb-error');

            const artist = {{ album.artist|json_encode|raw }};
            const title = {{ album.title|json_encode|raw }};

            fetchBtn.addEventListener('click', function() {
                placeholderDiv.style.display = 'none';
                contentDiv.style.display = 'none';
                loadingDiv.style.display = 'block';
                fetchBtn.disabled = true;

                const searchUrl = '/album/lookup?artist=' + encodeURIComponent(artist) + '&title=' + encodeURIComponent(title);

                fetch(searchUrl)
                    .then(response => response.json())
                    .then(data => {
                        if (data.error || !data || data.length === 0) {
                            throw new Error('Album not found in MusicBrainz database');
                        }

                        const firstResult = data[0];
                        if (!firstResult.mbid) {
                            throw new Error('No MusicBrainz ID found');
                        }

                        return fetch('/album/details/' + firstResult.mbid);
                    })
                    .then(response => response.json())
                    .then(details => {
                        loadingDiv.style.display = 'none';
                        fetchBtn.disabled = false;
                        errorDiv.style.display = 'none';

                        if (details.error) {
                            throw new Error(details.error);
                        }

                        document.getElementById('mb-release-date').textContent = details.releaseDate || 'Unknown';
                        document.getElementById('mb-country').textContent = details.country || 'Unknown';
                        document.getElementById('mb-label').textContent = details.label || 'Unknown';
                        document.getElementById('mb-barcode').textContent = details.barcode || 'N/A';
                        document.getElementById('mb-status').textContent = details.status || 'Unknown';
                        document.getElementById('mb-track-count').textContent = details.trackCount || '0';

                        if (details.trackList && details.trackList.length > 0) {
                            const tracksList = document.getElementById('mb-tracks-list');
                            tracksList.innerHTML = '';
                            details.trackList.forEach(function(track) {
                                const li = document.createElement('li');
                                li.innerHTML = `<strong>${track.title}</strong> <span class="text-muted">(${track.lengthFormatted || '?:??'})</span>`;
                                tracksList.appendChild(li);
                            });
                            document.getElementById('mb-tracks-section').style.display = 'block';
                        }

                        contentDiv.style.display = 'block';
                        fetchBtn.innerHTML = '<i class="bi bi-check-circle"></i> Loaded';
                        fetchBtn.classList.remove('btn-light');
                        fetchBtn.classList.add('btn-success');
                    })
                    .catch(error => {
                        loadingDiv.style.display = 'none';
                        fetchBtn.disabled = false;
                        errorDiv.textContent = error.message || 'Could not fetch MusicBrainz data. The album may not be in their database.';
                        errorDiv.style.display = 'block';
                    });
            });
        });
    </script>
{% endblock %}
