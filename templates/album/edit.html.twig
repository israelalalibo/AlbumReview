{% extends 'base.html.twig' %}

{% block title %}Edit Album - {{ album.title }}{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h1 class="mb-4">Edit Album</h1>

            {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}
            <div class="card mb-3">
                <div class="card-body">
                    {% if album.coverImage %}
                        <div class="mb-3">
                            <label class="form-label">Current Cover</label>
                            <div>
                                <img src="{{ asset('uploads/albums/' ~ album.coverImage) }}" alt="{{ album.title }}" class="img-thumbnail" style="max-width: 200px;">
                            </div>
                        </div>
                    {% endif %}

                    <div class="mb-3">
                        {{ form_label(form.title, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.title, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.title) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.artist, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.artist, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.artist) }}
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            {{ form_label(form.genre, null, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.genre, {'attr': {'class': 'form-select'}}) }}
                            {{ form_errors(form.genre) }}
                        </div>

                        <div class="col-md-6 mb-3">
                            {{ form_label(form.releaseYear, null, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.releaseYear, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.releaseYear) }}
                        </div>
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.coverImageFile, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.coverImageFile, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.coverImageFile) }}
                        <small class="form-text text-muted">Leave empty to keep current image</small>
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.trackList, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.trackList, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.trackList) }}
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle"></i> Update Album
                </button>
                <a href="{{ path('album_show', {slug: album.slug}) }}" class="btn btn-secondary">Cancel</a>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}

{% block stylesheets %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}
